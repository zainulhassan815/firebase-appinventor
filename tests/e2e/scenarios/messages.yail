(define-event Screen1 Initialize()(set-this-form)
  (call-component-method 'Messaging1 'GetToken (*list-for-runtime*) '()))

(define-event Messaging1 MessageReceived($from $data $title $body)(set-this-form)
  ((get-var p$report) (string-append "message|" (lexical-value $from) "|" (coerce-to-string (lexical-value $data)) "|" (lexical-value $title) "|" (lexical-value $body))))
