(define-event Screen1 Initialize()(set-this-form)
  (call-component-method 'Messaging1 'GetToken (*list-for-runtime*) '())
  (call-component-method 'Messaging1 'InitializeApp (*list-for-runtime* "@APP_ID@" "@API_KEY@" "@PROJECT_ID@" "@SENDER_ID@") '(text text text text))
  (call-component-method 'Messaging1 'InitializeApp (*list-for-runtime* "@APP_ID@" "@API_KEY@" "other-project" "@SENDER_ID@") '(text text text text))
  (call-component-method 'Messaging1 'SubscribeToTopic (*list-for-runtime* "not a topic!") '(text))
  (call-component-method 'Messaging1 'GetToken (*list-for-runtime*) '()))
